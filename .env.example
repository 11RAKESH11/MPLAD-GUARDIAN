# ==============================================================================
# MPLAD GUARDIAN — Production Environment Configuration Template (Phase 4.5)
# SIH 2026 | Problem Statement SIH26102
# ==============================================================================

# Application Environment: 'production', 'staging', or 'development'
ENVIRONMENT=production

# Debug Mode: MUST be false in production to prevent stack trace disclosure
DEBUG=false

# Enable Interactive API Documentation (/docs, /redoc)
ENABLE_DOCS=false

# Database Configuration (PostgreSQL 15+ with PostGIS primary, SQLite fallback)
POSTGRES_DB=mplad_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://app_user:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/mplad_db
DATABASE_PATH=/app/mplad.db

# Database Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=10

# Redis Caching & Queue Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=3
REDIS_SOCKET_TIMEOUT=5

# Cryptographic Key for JWT Signing (HMAC-SHA256)
# CRITICAL: In production, MUST be a cryptographically random string (min 32 bytes).
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# CORS Approved Origins (Comma-separated list of fully qualified domains)
ALLOWED_ORIGINS=https://mpladguardian.gov.in,https://app.mpladguardian.gov.in,http://localhost:5173

# Internal AI Service Configuration (Internal Docker network only)
AI_SERVICE_URL=http://ai-service:8001
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_INTERNAL_SERVICE_SHARED_TOKEN

# Network Binding
HOST=0.0.0.0
PORT=8000
